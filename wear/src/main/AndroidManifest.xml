<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_wear"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- 폰 앱이 있어야 동작한다 (알람 계산은 폰이 한다) -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!--
          이 워치 앱이 깔려 있으면 폰 앱 알림을 워치로 넘기지 않는다 (알림이 두 번 뜨지 않도록).
          승하차 알림은 워치 앱이 직접 띄우고 길게 진동한다.
        -->
        <meta-data
            android:name="com.google.android.wearable.notificationBridgeMode"
            android:value="NO_BRIDGING" />

        <activity
            android:name=".AlarmActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 폰에서 보낸 알람 상태를 받는다 -->
        <service
            android:name=".AlarmDataListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:path="/bus_alarm"
                    android:scheme="wear" />
            </intent-filter>
            <!-- 폰에서 온 승하차 알림 (워치가 직접 길게 진동) -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/bus_alarm/alert"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- 타일 -->
        <service
            android:name=".AlarmTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_launcher_wear" />
        </service>

        <!-- 워치 페이스 컴플리케이션 (남은 정류장 수) -->
        <service
            android:name=".RemainingComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_bus"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <!-- 0 = 정해진 주기로 부르지 않고, 폰에서 상태가 올 때마다 직접 갱신을 요청한다 -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 현위치 갱신 버튼 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 승하차 알람: 진행 상황 알림 · 알림 울리기 · 앱을 닫아도 계속 지켜보기 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 포그라운드 서비스 유형(location · dataSync)은 아래 AlarmService 에 선언. 스토어 등록 시 사용 목적을 따로 적는다 -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 안드로이드 16 Live Update (상태바 칩 · 삼성 Now Bar) -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CcBusWidget">

        <!-- 앱을 실행하면 지도 화면이 먼저 열린다.
             라이트/다크 모드를 바꿔도 화면을 새로 만들지 않는다 (지도 위치 · 열어 둔 시트 · 검색 상태 유지).
             색은 Compose 가 새 설정으로 다시 그리고, 지도 야간 모드는 nightMode 로 따라간다. -->
        <activity
            android:name=".feature.stopdetail.StopDetailActivity"
            android:configChanges="uiMode"
            android:theme="@style/Theme.CcBusWidget.Starting"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- 계정 설정 (네이버 로그인 · 즐겨찾기 동기화) -->
        <activity
            android:name=".feature.account.AccountActivity"
            android:exported="false"
            android:label="계정 설정" />

        <activity
            android:name=".feature.widgetconfig.WidgetConfigurationActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.CcBusWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 승하차 알람 (승차: 도착 정보 확인 / 하차: GPS 로 정류장 따라가기) -->
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync" />

        <!-- 갤럭시 워치에서 [해제] 를 누르면 오는 메시지 -->
        <service
            android:name=".alarm.WearMessageListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/bus_alarm/cancel"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.BusWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bus_widget_info" />
        </receiver>

    </application>
</manifest>

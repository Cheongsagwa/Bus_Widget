<?xml version="1.0" encoding="utf-8"?>
<!--
  다크 모드 색상. 여기 없는 이름은 values/colors.xml 값을 그대로 쓴다.
-->
<resources>
    <color name="navigation_selected">#FF505054</color>
    <color name="navigation_menu_button">#FF3A3A3C</color>
    <color name="favorites_surface">#FF17171A</color>
    <!-- 유리 표면: 밝을 때 #F1F1F3 → 어두울 때 #2E2E30 -->
    <color name="glass_surface">#802E2E30</color>
    <color name="glass_surface_white">#802E2E30</color>

    <!-- 유리 표면 위 아이콘·글자 -->
    <color name="glass_on_surface">#FFFFFFFF</color>

    <!-- 확장창 · 검색창 -->
    <color name="expanded_surface">#FF17171A</color>
    <color name="expanded_button">#FF3A3A3C</color>

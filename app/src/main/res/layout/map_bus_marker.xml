<?xml version="1.0" encoding="utf-8"?>
<!--
  지도 위 '운행 중인 버스' 마커.
  Figma 처럼 [버스 아이콘 원] + [차량번호 칩] 을 한 덩어리로 그려서
  OverlayImage.fromView 로 마커 이미지를 만든다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/bus_circle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/map_stop_marker" />

    <TextView
        android:id="@+id/vehicle_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:background="@drawable/vehicle_chip_bg"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="0000"
        android:textColor="@color/route_badge_text"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#660B0B0F">

    <!--
      루트 뷰 ID 가 @android:id/background 이고 배경 알파가 1~254 이면
      One UI Home 7.0+ 런처가 위젯 뒤 배경화면을 캡처해 블러 처리해 준다.
      (그 외 런처에서는 아래 ImageView 패널로 반투명 처리)
      색과 투명도는 실행 중에 WidgetRenderer 가 다시 칠한다.
    -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_shape" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/widget_padding_start"
        android:paddingTop="@dimen/widget_padding_top"
        android:paddingEnd="@dimen/widget_padding_end"
        android:paddingBottom="@dimen/widget_padding_bottom">

        <!-- 헤더 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stop_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="정류장"
                android:textColor="@color/widget_text_dark"
                android:textSize="@dimen/widget_stop_name_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updated_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_header_icon_gap"
                android:text=""
                android:textColor="@color/widget_subtext_dark"
                android:textSize="@dimen/widget_updated_text" />

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="@dimen/widget_refresh_button_size"
                android:layout_height="@dimen/widget_refresh_button_size"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:padding="@dimen/widget_refresh_button_padding"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- 노선 행이 동적으로 추가되는 영역 -->
        <LinearLayout
            android:id="@+id/rows_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_rows_top_margin"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/widget_subtext_dark"
            android:textSize="@dimen/widget_message_text"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      새로고침 중이거나, 새로고침한 지 오래됐을 때 위젯 전체에 씌우는 가림막.
      색과 투명도는 실행 중에 WidgetRenderer 가 칠한다.
    -->
    <FrameLayout
        android:id="@+id/refresh_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/overlay_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bg_shape" />

        <!-- 새로고침한 지 오래됨: 눌러서 새로고침 -->
        <ImageView
            android:id="@+id/overlay_refresh"
            android:layout_width="@dimen/widget_overlay_icon_size"
            android:layout_height="@dimen/widget_overlay_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_refresh"
            android:visibility="gone" />

        <!--
          새로고침 중: 도는 표시.
          RemoteViews 로는 색을 바꿀 수 없어서 밝은쪽·어두운쪽을 미리 두 개 만들어 두고
          보이기만 바꾼다. (색은 위 아이콘과 같은 값)
        -->
        <ProgressBar
            android:id="@+id/overlay_spinner_dark"
            style="?android:attr/progressBarStyle"
            android:layout_width="@dimen/widget_overlay_icon_size"
            android:layout_height="@dimen/widget_overlay_icon_size"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/widget_text_dark"
            android:indeterminateTintMode="src_in"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/overlay_spinner_light"
            style="?android:attr/progressBarStyle"
            android:layout_width="@dimen/widget_overlay_icon_size"
            android:layout_height="@dimen/widget_overlay_icon_size"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/widget_text_light"
            android:indeterminateTintMode="src_in"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
